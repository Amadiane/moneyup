# Copie ce fichier sous le nom .env.local et remplis les 3 valeurs.
# .env.local n'est JAMAIS envoyé sur GitHub (il est dans .gitignore).
# Sur Vercel, ces mêmes variables se saisissent dans :
#   Project > Settings > Environment Variables

# Supabase > Project Settings > API Keys
# La clé "publishable" peut être publique : la sécurité est assurée par les règles de la base.
# Ne mets JAMAIS ici la clé "secret" / "service_role".
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Adresse publique du site, SANS / à la fin. Sert à l'aperçu du lien sur WhatsApp.
# En local : http://localhost:5173
# Sur Vercel : https://ton-projet.vercel.app (ou ton nom de domaine)
VITE_SITE_URL=http://localhost:5173